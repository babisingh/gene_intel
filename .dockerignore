# Keep downloaded genomic data out of the build context and the web app image.
# By default the download scripts in scripts/ write GTF and BioMart files to
# the top-level data/ folder. The graph itself lives in the Railway neo4j
# service, built into that service's image by graphdb/ (see graphdb/README.md).
# These patterns only match data/ at the top of the repository. The GTF files
# committed in backend/data/gtf are still copied into the image with backend/.
data/
data/gtf/
data/biomart/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# Node
frontend/node_modules/
frontend/.cache/

# Local env — never bake credentials into the image
.env
backend/.env
*.env

# Git
.git/
.gitignore

# Dev/test artefacts
*.log
*.tmp
coverage/
.coverage
htmlcov/
