{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "graphdb/Dockerfile",
    "watchPatterns": [
      "graphdb/**",
      "backend/data/gtf/**",
      "backend/app/ingestion/**",
      "backend/app/db/schema.py"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
